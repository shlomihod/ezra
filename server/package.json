{
  "name": "ezra-server",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun install --no-summary && ([ -f ../client/dist/index.html ] || (cd ../client && bunx vite build >&2)) && bun src/stdio.ts",
    "build": "tsc --noEmit",
    "dev": "bun --watch src/index.ts",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tiptap/core": "^3.22.1",
    "@tiptap/starter-kit": "^3.22.1",
    "cors": "^2.8.6",
    "diff-match-patch": "^1.0.5",
    "express": "^4.22.1",
    "helmet": "^8.1.0",
    "jsdom": "^28.1.0",
    "nanoid": "^5.1.7",
    "open": "^10.2.0",
    "prosemirror-model": "^1.25.4",
    "tiptap-markdown": "^0.9.0",
    "ws": "^8.20.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/cors": "^2.8.19",
    "@types/diff-match-patch": "^1.0.36",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^28.0.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.19.15",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  }
}
